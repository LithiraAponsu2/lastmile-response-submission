LASTMILE_LLM=fake
LASTMILE_TEAM_DEMO=true
LASTMILE_MAIL=off
LASTMILE_ALLOW_ACTUAL=0
LASTMILE_DEV_MAILBOX=false
LASTMILE_DATA_DIR=var
LASTMILE_DRAFTING=templates
PORT=8080
